# ============= Flash Sale — Frontend Environment Variables =============
# Copy to .env for local overrides. Not required for normal dev - the app
# talks to the backend via a same-origin relative /api path (proxied by
# Vite in dev, by nginx in the containerized stack), so this only matters
# if you're pointing the dev server's proxy at a non-default backend.

# Dev-server proxy target for /api/* (see vite.config.ts). Defaults to
# http://localhost:3001 if unset.
VITE_API_URL=http://localhost:3001
