{
    "name": "@flash-sale/server",
    "version": "1.0.0",
    "description": "High-throughput flash sale backend service",
    "main": "dist/index.js",
    "private": true,
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "build": "tsc && node -e \"require('fs').cpSync('src/db/init.sql','dist/db/init.sql')\"",
        "start": "node dist/index.js",
        "start:prod": "NODE_ENV=production node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:stress": "tsx src/scripts/stress-test.ts",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "health": "curl -f http://localhost:3001/health || exit 1",
        "metrics": "curl -s http://localhost:3001/metrics | jq ."
    },
    "dependencies": {
        "@fastify/cors": "^8.5.0",
        "@fastify/helmet": "^11.1.1",
        "@fastify/rate-limit": "^9.0.1",
        "@fastify/swagger": "^8.15.0",
        "@fastify/swagger-ui": "^2.1.0",
        "fastify": "^4.25.2",
        "pino": "^8.17.2",
        "pino-pretty": "^10.3.1",
        "postgres": "^3.4.9",
        "redis": "^6.2.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^8.56.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.1.0"
    },
    "engines": {
        "node": ">=20.0.0 <21.0.0"
    }
}
