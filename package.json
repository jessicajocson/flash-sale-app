{
  "name": "flash-sale",
  "version": "1.0.0",
  "description": "High-throughput flash sale system - Production-grade backend",
  "private": true,
  "workspaces": [
    "packages/server",
    "packages/frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run --workspace=@flash-sale/server dev\" \"npm run --workspace=@flash-sale/frontend dev\"",
    "dev:backend": "npm run --workspace=@flash-sale/server dev",
    "dev:frontend": "npm run --workspace=@flash-sale/frontend dev",
    "build": "npm run --workspace=@flash-sale/server build && npm run --workspace=@flash-sale/frontend build",
    "build:backend": "npm run --workspace=@flash-sale/server build",
    "build:frontend": "npm run --workspace=@flash-sale/frontend build",
    "test:backend": "npm run --workspace=@flash-sale/server test",
    "test:frontend": "npm run --workspace=@flash-sale/frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "test:stress": "npm run --workspace=@flash-sale/server test:stress",
    "test:all": "npm run test && npm run test:stress",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:prod:rebuild": "docker-compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=9.0.0"
  }
}
