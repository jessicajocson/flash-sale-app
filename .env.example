# ============= Flash Sale - Environment Variables =============
# Production-Ready Configuration with PostgreSQL + Redis
# Copy to .env.local for development, .env.prod for production

# ============= SERVER CONFIGURATION =============
NODE_ENV=development              # development | staging | production
LOG_LEVEL=debug                   # debug | info | warn | error
PORT=3001                         # Backend server port
HOST=0.0.0.0                      # Bind to all interfaces

# ============= DATABASE CONFIGURATION =============
# PostgreSQL for persistent data storage. Matches the `postgres` service in
# the root docker-compose.yml (docker-compose up -d postgres redis).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/flash_sale_db
DATABASE_POOL_SIZE=10             # Connection pool size
DATABASE_IDLE_TIMEOUT=30000       # Idle connection timeout (ms)

# ============= REDIS CONFIGURATION =============
# Redis for rate limiting, CSRF tokens, caching
REDIS_URL=redis://localhost:6379

# ============= FLASH SALE CONFIGURATION =============
STOCK=100                         # Number of items available
# SALE_START / SALE_END (ISO 8601, UTC) - leave unset for local dev/demo
# and the server defaults to a sale starting 1 minute after boot and
# running for 5 minutes, which is more useful than a fixed past window.
# SALE_START=2026-01-15T14:00:00Z
# SALE_END=2026-01-15T14:05:00Z

# ============= SECURITY =============
CORS_ORIGIN=http://localhost:3000 # Frontend URL for CORS
ADMIN_KEY=dev-admin-secret-key    # Admin endpoint key (change in production!)

# ============= FRONTEND =============
VITE_API_URL=http://localhost:3001 # Backend API URL

# ============= PRODUCTION ONLY SETTINGS =============
# DO NOT COMMIT THESE - USE ENVIRONMENT VARIABLES OR SECRETS MANAGER

# Database (Production)
# DATABASE_URL=postgresql://prod_user:STRONG_PASSWORD@prod-db.example.com:5432/flash_sale_prod
# DATABASE_POOL_SIZE=20
# DATABASE_IDLE_TIMEOUT=60000

# Redis (Production) - Use Redis cluster or managed Redis
# REDIS_URL=redis://prod-redis-user:PASSWORD@prod-redis.example.com:6379/0

# Admin Key (Production) - Strong random value
# ADMIN_KEY=generate-with-openssl-rand-hex-32

# CORS (Production)
# CORS_ORIGIN=https://flash-sale.bookipi.com

# ============= MONITORING & LOGGING =============
# Optional: Structured logging destinations
# DATADOG_API_KEY=your-datadog-api-key
# SENTRY_DSN=your-sentry-dsn

# ============= FEATURES =============
# Optional feature flags
# ENABLE_RATE_LIMITING=true
# ENABLE_CIRCUIT_BREAKER=true
# ENABLE_AUDIT_LOGGING=true

# ============= DOCKER COMPOSE =============
# When using docker-compose.prod.yml, these are set automatically:
# - Database: postgres service (no need to change)
# - Redis: redis service (no need to change)
# - Frontend connects to backend automatically

# ============= DEVELOPMENT HELPERS =============
DEBUG=*                           # Enable debug logging
WATCH=true                        # Enable file watching for dev server
SEED_DATABASE=true                # Auto-seed database on startup